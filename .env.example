# Copy to .env and fill in. Real environment variables override these.

# Your Sleeper username (required for defaults and the dashboard)
SLEEPER_USERNAME=

# Optional: if unset, your only league this season is used
SLEEPER_LEAGUE_ID=

# Dashboard (npm run dashboard)
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from your home network
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3030

# HTTP MCP endpoint for claude.ai / the Claude phone app (npm run mcp:http)
# Served only at /mcp/<MCP_HTTP_SECRET>. Use a long random value; run
# `npm run mcp:http` without one and it prints a fresh one for you.
MCP_HTTP_SECRET=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3031

# Dashboard live feed: seconds between score polls while one of your players
# is in a game (1-60). Other feeds use slower fixed schedules.
LIVE_POLL_SECONDS=2
